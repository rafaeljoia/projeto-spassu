# ==============================================================================
# PROJETO SPASSU - SISTEMA DE VENDAS E COMISSÕES DE PAPELARIA
# Arquivo de exclusão de arquivos e diretórios do Git (.gitignore)
# ==============================================================================
# Convenções de formatação de código adotadas no projeto:
# - Python / Django: Conformidade estrita com PEP 8, indentação de 4 espaços, UTF-8.
# - TypeScript / React: Indentação de 2 espaços, UTF-8, camelCase / PascalCase.
# - Documentação e comentários: Redigidos em Português do Brasil (pt-BR).
# - Identificadores e código-fonte: Nomenclatura em Inglês internacional.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTES, SEGREDOS E CREDENCIAIS (Twelve-Factor App & Princípio IX)
# NUNCA comitar credenciais, senhas ou arquivos de ambiente com dados reais.
# ------------------------------------------------------------------------------
.env
.env.local
.env.prod
.env.*.local
*.env
*.env.local

# Whitelist obrigatória: Manter os templates de exemplo versionados
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 2. PYTHON & DJANGO
# ------------------------------------------------------------------------------
# Byte-compiled / otimizados / cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Distribuição / empacotamento
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Ambientes virtuais
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Logs e diagnósticos Python
*.log
pip-log.txt
pip-delete-this-directory.txt

# Arquivos estáticos coletados e mídia em desenvolvimento
staticfiles/
backend/staticfiles/
media/
backend/media/

# Bancos de dados locais / SQLite
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# Testes automatizados e cobertura (Pytest / Coverage)
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/
.hypothesis/

# ------------------------------------------------------------------------------
# 3. NODE.JS, TYPESCRIPT & VITE (FRONTEND)
# ------------------------------------------------------------------------------
# Dependências do Node
node_modules/
frontend/node_modules/

# Saída de compilação / build
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo
*.local

# Logs de gerenciadores de pacotes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura de testes do Vitest / Jest
coverage/
frontend/coverage/

# ------------------------------------------------------------------------------
# 4. CONTAINERS, DOCKER & BANCO DE DADOS LOCAL
# ------------------------------------------------------------------------------
# Diretórios de persistência montados localmente fora do volume Docker
postgres_data/
pgdata/
docker-data/

# ------------------------------------------------------------------------------
# 5. EDITORES DE CÓDIGO E IDES
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, IntelliJ IDEA)
.idea/
*.iml

# Visual Studio / Windows Dev Tools
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 6. ARQUIVOS DO SISTEMA OPERACIONAL
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 7. BACKUPS, ARQUIVOS TEMPORÁRIOS E ESPECIFICAÇÃO LOCAL
# ------------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.swp

# Spec Kit - Estado local por checkout (não compartilhado)
.specify/feature.json
.specify/extensions/*/local-config.yml
