# ==============================================================================
# Local Development Environment Configuration (.env.local)
# Utilizado para desenvolvimento e execução local via docker-compose
# ==============================================================================

# --- Configurações Gerais do Django ---
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-local-dev-spassu-secret-key-not-for-production-use
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Banco de Dados PostgreSQL ---
POSTGRES_DB=spassu_db
POSTGRES_USER=spassu_user
POSTGRES_PASSWORD=spassu_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://spassu_user:spassu_password@db:5432/spassu_db

# --- CORS (Cross-Origin Resource Sharing) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
